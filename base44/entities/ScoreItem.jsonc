{
  "name": "ScoreItem",
  "type": "object",
  "properties": {
    "student_email": {
      "type": "string",
      "description": "Email do aluno"
    },
    "category": {
      "type": "string",
      "enum": [
        "lesson",
        "live_attendance",
        "task",
        "quiz",
        "forum"
      ],
      "description": "Categoria do item pontu\u00e1vel"
    },
    "ref_id": {
      "type": "string",
      "description": "ID do item de refer\u00eancia (aula, sess\u00e3o, tarefa, post)"
    },
    "ref_title": {
      "type": "string",
      "description": "T\u00edtulo do item de refer\u00eancia"
    },
    "score": {
      "type": "number",
      "default": 0,
      "description": "Pontua\u00e7\u00e3o atribu\u00edda"
    },
    "max_score": {
      "type": "number",
      "default": 10,
      "description": "Pontua\u00e7\u00e3o m\u00e1xima"
    },
    "verified": {
      "type": "boolean",
      "default": false,
      "description": "Item verificado pelo professor"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es do professor"
    }
  },
  "required": [
    "student_email",
    "category",
    "ref_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}