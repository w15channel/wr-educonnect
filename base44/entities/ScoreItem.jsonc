{
  "name": "ScoreItem",
  "type": "object",
  "properties": {
    "student_email": {
      "type": "string",
      "description": "Email do aluno"
    },
    "category": {
      "type": "string",
      "enum": [
        "lesson",
        "live_attendance",
        "task",
        "quiz",
        "forum",
        "exam",
        "therapist",
        "ofensiva"
      ],
      "description": "Categoria do item pontuável"
    },
    "ref_id": {
      "type": "string",
      "description": "ID do item de referência (aula, sessão, tarefa, post)"
    },
    "ref_title": {
      "type": "string",
      "description": "Título do item de referência"
    },
    "module_number": {
      "type": "number",
      "minimum": 1,
      "maximum": 10,
      "description": "Módulo acadêmico (1-10) usado na classificação e no histórico"
    },
    "score": {
      "type": "number",
      "default": 0,
      "description": "Pontuação atribuída"
    },
    "max_score": {
      "type": "number",
      "default": 10,
      "description": "Pontuação máxima"
    },
    "verified": {
      "type": "boolean",
      "default": false,
      "description": "Item verificado pelo professor"
    },
    "notes": {
      "type": "string",
      "description": "Observações do professor"
    }
  },
  "required": [
    "student_email",
    "category",
    "ref_id"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}
