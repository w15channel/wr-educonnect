{
  "name": "RecordedLesson",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Title of the lesson"
    },
    "description": {
      "type": "string",
      "description": "Brief description of the lesson"
    },
    "course": {
      "type": "string",
      "enum": [
        "tcc",
        "psicanalise",
        "sexologia"
      ],
      "default": "tcc",
      "description": "Curso ao qual a aula pertence"
    },
    "lesson_type": {
      "type": "string",
      "enum": [
        "video_external",
        "text_written",
        "content_external"
      ],
      "default": "video_external",
      "description": "Tipo de aula"
    },
    "video_url": {
      "type": "string",
      "description": "URL do vídeo (YouTube, Vimeo, Instagram, etc.)"
    },
    "external_url": {
      "type": "string",
      "description": "URL de material externo (artigo, site, etc.)"
    },
    "text_content": {
      "type": "string",
      "description": "Conteúdo de aula em texto (quando lesson_type=text_written)"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "Thumbnail image URL"
    },
    "duration": {
      "type": "string",
      "description": "Duration of the lesson (e.g., 45 min)"
    },
    "order": {
      "type": "number",
      "description": "Order of the lesson in the course"
    },
    "material_links": {
      "type": "string",
      "description": "Links de materiais de suporte (separados por vírgula)"
    },
    "research_links": {
      "type": "string",
      "description": "Links para pesquisa online (separados por vírgula com títulos separados por |)"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}
