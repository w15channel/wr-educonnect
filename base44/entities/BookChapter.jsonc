{
  "name": "BookChapter",
  "type": "object",
  "properties": {
    "book_id": {
      "type": "string",
      "description": "ID do livro"
    },
    "author_email": {
      "type": "string",
      "description": "Email do autor"
    },
    "title": {
      "type": "string",
      "description": "Título do capítulo"
    },
    "content": {
      "type": "string",
      "description": "Conteúdo do capítulo (HTML rich text)"
    },
    "order": {
      "type": "number",
      "default": 1,
      "description": "Ordem do capítulo"
    },
    "book_title": {
      "type": "string",
      "description": "Título do livro/apostila"
    },
    "chapter_id": {
      "type": "string",
      "description": "Identificador estável do módulo da apostila"
    },
    "chapter_title": {
      "type": "string",
      "description": "Título do módulo da apostila"
    },
    "lesson_id": {
      "type": "string",
      "description": "Identificador estável da aula dentro do módulo"
    }
  },
  "required": [
    "book_id",
    "author_email",
    "title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.author_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": true,
    "update": {
      "$or": [
        {
          "data.author_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.author_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
