{
  "name": "BookChapter",
  "type": "object",
  "properties": {
    "book_id": {
      "type": "string",
      "description": "ID do livro"
    },
    "author_email": {
      "type": "string",
      "description": "Email do autor"
    },
    "title": {
      "type": "string",
      "description": "Título do capítulo"
    },
    "content": {
      "type": "string",
      "description": "Conteúdo do capítulo (HTML rich text)"
    },
    "content_url": {
      "type": "string",
      "description": "URL do arquivo de conteúdo quando o texto for grande demais para salvar inline"
    },
    "content_storage": {
      "type": "string",
      "enum": [
        "inline",
        "file"
      ],
      "default": "inline",
      "description": "Onde o conteúdo principal foi armazenado"
    },
    "chapter_id": {
      "type": "string",
      "description": "Identificador estável do módulo da apostila"
    },
    "chapter_title": {
      "type": "string",
      "description": "Título do módulo da apostila"
    },
    "lesson_id": {
      "type": "string",
      "description": "Identificador estável da aula dentro do módulo"
    },
    "lesson_title": {
      "type": "string",
      "description": "Título original da aula"
    },
    "course": {
      "type": "string",
      "enum": [
        "tcc",
        "psicanalise",
        "sexologia"
      ],
      "default": "tcc",
      "description": "Curso ao qual a aula da apostila pertence"
    },
    "order": {
      "type": "number",
      "default": 1,
      "description": "Ordem do capítulo"
    },
    "book_title": {
      "type": "string",
      "description": "Título do livro/apostila"
    }
  },
  "required": [
    "book_id",
    "author_email",
    "title"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}
