{
  "name": "BookChapter",
  "type": "object",
  "properties": {
    "book_id": {
      "type": "string",
      "description": "ID do livro"
    },
    "author_email": {
      "type": "string",
      "description": "Email do autor"
    },
    "title": {
      "type": "string",
      "description": "Título do capítulo"
    },
    "content": {
      "type": "string",
      "description": "Conteúdo do capítulo (HTML rich text)"
    },
    "content_url": {
      "type": "string",
      "description": "URL do arquivo de conte\u00fado quando o texto for grande demais para salvar inline"
    },
    "content_storage": {
      "type": "string",
      "enum": [
        "inline",
        "file"
      ],
      "default": "inline",
      "description": "Onde o conte\u00fado principal foi armazenado"
    },
    "chapter_id": {
      "type": "string",
      "description": "Identificador est\u00e1vel do m\u00f3dulo da apostila"
    },
    "chapter_title": {
      "type": "string",
      "description": "T\u00edtulo do m\u00f3dulo da apostila"
    },
    "lesson_id": {
      "type": "string",
      "description": "Identificador est\u00e1vel da aula dentro do m\u00f3dulo"
    },
    "lesson_title": {
      "type": "string",
      "description": "T\u00edtulo original da aula"
    },
    "course": {
      "type": "string",
      "enum": [
        "tcc",
        "psicanalise",
        "sexologia"
      ],
      "default": "tcc",
      "description": "Curso ao qual a aula da apostila pertence"
    },
    "order": {
      "type": "number",
      "default": 1,
      "description": "Ordem do capítulo"
    },
    "book_title": {
      "type": "string",
      "description": "Título do livro/apostila"
    },
    "chapter_id": {
      "type": "string",
      "description": "Identificador estável do módulo da apostila"
    },
    "chapter_title": {
      "type": "string",
      "description": "Título do módulo da apostila"
    },
    "lesson_id": {
      "type": "string",
      "description": "Identificador estável da aula dentro do módulo"
    }
  },
  "required": [
    "book_id",
    "author_email",
    "title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.author_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": true,
    "update": {
      "$or": [
        {
          "data.author_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.author_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
