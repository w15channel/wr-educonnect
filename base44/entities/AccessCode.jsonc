{
  "name": "AccessCode",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "The unique access code"
    },
    "student_name": {
      "type": "string",
      "description": "Name of the student this code belongs to"
    },
    "student_email": {
      "type": "string",
      "description": "Email of the student (optional)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this code is active"
    },
    "course": {
      "type": "string",
      "enum": [
        "tcc",
        "psicanalise",
        "sexologia"
      ],
      "default": "tcc",
      "description": "Curso vinculado ao aluno"
    },
    "profile_name": {
      "type": "string",
      "description": "Student's display name after login"
    },
    "profile_bio": {
      "type": "string",
      "description": "Student's bio"
    },
    "profile_avatar_color": {
      "type": "string",
      "description": "Avatar color hex"
    },
    "profile_photo_url": {
      "type": "string",
      "description": "Student profile photo URL"
    },
    "last_login": {
      "type": "string",
      "description": "Last login timestamp"
    }
  },
  "required": [
    "code"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.student_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.student_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}