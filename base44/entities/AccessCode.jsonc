{
  "name": "AccessCode",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "The unique access code"
    },
    "student_name": {
      "type": "string",
      "description": "Name of the student this code belongs to"
    },
    "student_email": {
      "type": "string",
      "description": "Email of the student (optional)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this code is active"
    },
    "course": {
      "type": "string",
      "enum": [
        "tcc",
        "psicanalise",
        "sexologia"
      ],
      "default": "tcc",
      "description": "Curso vinculado ao aluno"
    },
    "profile_name": {
      "type": "string",
      "description": "Student's display name after login"
    },
    "profile_bio": {
      "type": "string",
      "description": "Student's bio"
    },
    "profile_avatar_color": {
      "type": "string",
      "description": "Avatar color hex"
    },
    "profile_avatar_emoji": {
      "type": "string",
      "description": "Emoji/avatar selecionado pelo aluno"
    },
    "profile_photo_url": {
      "type": "string",
      "description": "Student profile photo URL"
    },
    "last_login": {
      "type": "string",
      "description": "Last login timestamp"
    },
    "last_seen_at": {
      "type": "string",
      "description": "Último momento em que o aluno esteve ativo no site"
    },
    "is_online": {
      "type": "boolean",
      "default": false,
      "description": "Se o aluno está online agora"
    },
    "site_notifications_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Se o aluno ativou notificações do site neste aparelho"
    },
    "pontuacao_total": {
      "type": "number",
      "default": 0,
      "description": "Pontuação total para ranking geral"
    },
    "pontuacao_estudos": {
      "type": "number",
      "default": 0,
      "description": "Pontuação acadêmica/estudos: aulas assistidas, trabalhos entregues e provas"
    }
  },
  "required": [
    "code"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}
