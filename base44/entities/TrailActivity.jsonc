{
  "name": "TrailActivity",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "T\u00edtulo da atividade de trilha"
    },
    "description": {
      "type": "string",
      "description": "Enunciado / instru\u00e7\u00f5es da atividade"
    },
    "type": {
      "type": "string",
      "enum": [
        "upload",
        "quiz",
        "text"
      ],
      "default": "text",
      "description": "Tipo de entrega"
    },
    "course": {
      "type": "string",
      "enum": [
        "tcc",
        "psicanalise",
        "sexologia"
      ],
      "default": "tcc",
      "description": "Curso ao qual a atividade pertence"
    },
    "order": {
      "type": "number",
      "description": "Posi\u00e7\u00e3o na trilha (1 a 15)"
    },
    "points_reward": {
      "type": "number",
      "default": 0.1,
      "description": "Pontos concedidos ao completar"
    },
    "quiz_questions": {
      "type": "array",
      "description": "Quest\u00f5es para atividades do tipo quiz",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "correct_index": {
            "type": "number"
          }
        }
      }
    }
  },
  "required": [
    "title",
    "type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}