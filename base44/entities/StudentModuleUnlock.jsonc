{
  "name": "StudentModuleUnlock",
  "type": "object",
  "properties": {
    "student_email": {
      "type": "string",
      "description": "Email do aluno liberado"
    },
    "student_name": {
      "type": "string",
      "description": "Nome do aluno"
    },
    "course": {
      "type": "string",
      "enum": [
        "tcc",
        "psicanalise",
        "sexologia"
      ],
      "default": "tcc"
    },
    "module_number": {
      "type": "number",
      "minimum": 1,
      "maximum": 10,
      "description": "M\u00f3dulo liberado \u2014 a partir deste instante o aluno \u00e9 pontuado nele"
    },
    "unlocked_at": {
      "type": "string",
      "format": "date-time",
      "description": "Instante da libera\u00e7\u00e3o"
    },
    "unlocked_by": {
      "type": "string",
      "description": "Email do admin que liberou"
    }
  },
  "required": [
    "student_email",
    "module_number",
    "unlocked_at"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}