{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "ID of the live session"
    },
    "author_name": {
      "type": "string",
      "description": "Name of the message author"
    },
    "author_email": {
      "type": "string",
      "description": "Email of the author"
    },
    "content": {
      "type": "string",
      "description": "Message content"
    },
    "is_hand_raised": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is a hand raise notification"
    }
  },
  "required": [
    "session_id",
    "content"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.author_email": "{{user.email}}"
        },
        {
          "data.session_id": {
            "$regex": "^class_chat_"
          }
        },
        {
          "data.session_id": {
            "$regex": "dm_((?:{{user.email}})_.*|.*_(?:{{user.email}}))$"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.author_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.author_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}