{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "ID of the live session"
    },
    "author_name": {
      "type": "string",
      "description": "Name of the message author"
    },
    "author_email": {
      "type": "string",
      "description": "Email of the author"
    },
    "content": {
      "type": "string",
      "description": "Message content"
    },
    "is_hand_raised": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is a hand raise notification"
    },
    "is_luna_distribution": {
      "type": "boolean",
      "default": false,
      "description": "Identifica mensagens distribu\u00eddas automaticamente pela Luna"
    },
    "distributed_by": {
      "type": "string",
      "description": "Administrador que acionou a distribui\u00e7\u00e3o da Luna"
    },
    "distribution_id": {
      "type": "string",
      "description": "Identificador comum do lote de distribui\u00e7\u00e3o"
    }
  },
  "required": [
    "session_id",
    "content"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}