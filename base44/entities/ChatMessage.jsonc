{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "ID of the live session"
    },
    "author_name": {
      "type": "string",
      "description": "Name of the message author"
    },
    "author_email": {
      "type": "string",
      "description": "Email of the author"
    },
    "content": {
      "type": "string",
      "description": "Message content"
    },
    "is_hand_raised": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is a hand raise notification"
    }
  },
  "required": [
    "session_id",
    "content"
  ],
  "rls": {
    "create": {
      "data.author_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.author_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.session_id": "class_chat_{{user.course}}"
        },
        {
          "$and": [
            {
              "data.session_id": {
                "$regex": "^dm_.*"
              }
            },
            {
              "$or": [
                {
                  "data.session_id": {
                    "$regex": "^dm_{{user.email}}_.*"
                  }
                },
                {
                  "data.session_id": {
                    "$regex": ".*_{{user.email}}$"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "data.author_email": "{{user.email}}"
    },
    "delete": {
      "$or": [
        {
          "data.author_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}