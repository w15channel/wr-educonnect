{
  "name": "MonitorHistory",
  "type": "object",
  "properties": {
    "student_email": {
      "type": "string",
      "description": "Email do aluno monitor"
    },
    "student_name": {
      "type": "string",
      "description": "Nome do aluno monitor"
    },
    "period_start": {
      "type": "string",
      "format": "date",
      "description": "In\u00edcio do per\u00edodo como monitor"
    },
    "period_end": {
      "type": "string",
      "format": "date",
      "description": "Fim do per\u00edodo como monitor"
    },
    "rank_position": {
      "type": "number",
      "description": "Posi\u00e7\u00e3o no ranking (1, 2 ou 3)"
    },
    "course": {
      "type": "string",
      "enum": [
        "tcc",
        "psicanalise",
        "sexologia"
      ],
      "default": "tcc",
      "description": "Turma/curso do monitor"
    }
  },
  "required": [
    "student_email",
    "period_start"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.student_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.course": "{{user.course}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}