{
  "name": "MonitorHistory",
  "type": "object",
  "properties": {
    "student_email": {
      "type": "string",
      "description": "Email do aluno monitor"
    },
    "student_name": {
      "type": "string",
      "description": "Nome do aluno monitor"
    },
    "period_start": {
      "type": "string",
      "format": "date",
      "description": "Início do período como monitor"
    },
    "period_end": {
      "type": "string",
      "format": "date",
      "description": "Fim do período como monitor"
    },
    "rank_position": {
      "type": "number",
      "description": "Posição no ranking (1, 2 ou 3)"
    },
    "course": {
      "type": "string",
      "enum": [
        "tcc",
        "psicanalise",
        "sexologia"
      ],
      "default": "tcc",
      "description": "Turma/curso do monitor"
    }
  },
  "required": [
    "student_email",
    "period_start"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}
