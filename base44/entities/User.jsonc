{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "teacher",
        "student"
      ],
      "default": "student",
      "description": "Role of the user in the platform"
    },
    "avatar_url": {
      "type": "string",
      "description": "Profile picture URL"
    },
    "bio": {
      "type": "string",
      "description": "Short biography"
    },
    "overall_grade": {
      "type": "number",
      "description": "Student's overall average grade"
    },
    "progress_percent": {
      "type": "number",
      "description": "Student's overall progress percentage"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "attention",
        "inactive"
      ],
      "default": "active",
      "description": "Student status"
    },
    "pontuacao_total": {
      "type": "number",
      "default": 0,
      "description": "Cache DECIMAL(10,3) da pontuação total do aluno; fonte única para rankings e exibição de pontos."
    },
    "pontuacao_estudos": {
      "type": "number",
      "default": 0,
      "description": "Cache DECIMAL(10,3) da pontuação de estudos: aulas assistidas, trabalhos entregues e provas."
    }
  },
  "required": [],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}
