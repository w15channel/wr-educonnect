{
  "name": "CalendarEvent",
  "type": "object",
  "properties": {
    "student_email": {
      "type": "string",
      "description": "Email do aluno dono do evento"
    },
    "title": {
      "type": "string",
      "description": "T\u00edtulo do evento"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do evento"
    },
    "date": {
      "type": "string",
      "description": "Data (YYYY-MM-DD)"
    },
    "time": {
      "type": "string",
      "description": "Hor\u00e1rio (HH:mm)"
    },
    "type": {
      "type": "string",
      "enum": [
        "personal",
        "study",
        "live",
        "task",
        "exam",
        "reminder"
      ],
      "default": "personal",
      "description": "Tipo do evento"
    },
    "event_date": {
      "type": "string",
      "format": "date",
      "description": "Data do evento (legado)"
    },
    "event_time": {
      "type": "string",
      "description": "Hor\u00e1rio legado"
    },
    "color": {
      "type": "string",
      "description": "Cor do evento"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "data.student_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.student_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.student_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.student_email": "{{user.email}}"
        }
      ]
    }
  }
}