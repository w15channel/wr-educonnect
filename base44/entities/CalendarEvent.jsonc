{
  "name": "CalendarEvent",
  "type": "object",
  "properties": {
    "student_email": {
      "type": "string",
      "description": "Email do aluno dono do evento"
    },
    "title": {
      "type": "string",
      "description": "Título do evento"
    },
    "description": {
      "type": "string",
      "description": "Descrição do evento"
    },
    "date": {
      "type": "string",
      "description": "Data (YYYY-MM-DD)"
    },
    "time": {
      "type": "string",
      "description": "Horário (HH:mm)"
    },
    "type": {
      "type": "string",
      "enum": [
        "personal",
        "study",
        "live",
        "task",
        "exam",
        "reminder"
      ],
      "default": "personal",
      "description": "Tipo do evento"
    },
    "event_date": {
      "type": "string",
      "format": "date",
      "description": "Data do evento (legado)"
    },
    "event_time": {
      "type": "string",
      "description": "Horário legado"
    },
    "color": {
      "type": "string",
      "description": "Cor do evento"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}
