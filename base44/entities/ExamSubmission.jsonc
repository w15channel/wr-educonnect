{
  "name": "ExamSubmission",
  "type": "object",
  "properties": {
    "exam_id": {
      "type": "string",
      "description": "ID da prova"
    },
    "student_email": {
      "type": "string",
      "description": "Email do aluno"
    },
    "student_name": {
      "type": "string",
      "description": "Nome do aluno"
    },
    "course": {
      "type": "string",
      "enum": [
        "tcc",
        "psicanalise",
        "sexologia",
        "aconselhamento-familiar"
      ],
      "enumColors": [
        "blue",
        "purple",
        "pink",
        "green"
      ],
      "default": "tcc",
      "description": "Curso da prova"
    },
    "quiz_answers": {
      "type": "array",
      "description": "Respostas do aluno \u2014 cada item \u00e9 \u00edndice (escolha) ou texto (escrita)",
      "items": {}
    },
    "grade": {
      "type": "number",
      "description": "Percentual de acerto obtido (0-100)"
    },
    "passed": {
      "type": "boolean",
      "description": "Verdadeiro quando o aluno atingiu ao menos 50% de acertos"
    },
    "correct_count": {
      "type": "number",
      "description": "Quantidade de quest\u00f5es respondidas corretamente"
    },
    "total_questions": {
      "type": "number",
      "description": "Total de quest\u00f5es da prova"
    },
    "accuracy_percent": {
      "type": "number",
      "description": "Percentual de acerto (0-100)"
    },
    "feedback": {
      "type": "string",
      "description": "Parecer instant\u00e2neo da corre\u00e7\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "graded"
      ],
      "default": "graded",
      "description": "Status da corre\u00e7\u00e3o"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data de envio da prova"
    },
    "graded_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data da corre\u00e7\u00e3o"
    },
    "graded_by": {
      "type": "string",
      "description": "Email do professor que corrigiu"
    },
    "time_spent_seconds": {
      "type": "number",
      "description": "Tempo gasto em segundos"
    },
    "tab_switch_detected": {
      "type": "boolean",
      "default": false,
      "description": "Se o aluno saiu da aba durante a prova"
    }
  },
  "required": [
    "exam_id",
    "student_email"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}