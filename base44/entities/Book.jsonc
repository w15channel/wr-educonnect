{
  "name": "Book",
  "type": "object",
  "properties": {
    "author_email": {
      "type": "string",
      "description": "Email do autor"
    },
    "author_name": {
      "type": "string",
      "description": "Nome do autor"
    },
    "title": {
      "type": "string",
      "description": "Título do livro"
    },
    "subtitle": {
      "type": "string",
      "description": "Subtítulo do livro"
    },
    "cover_image_url": {
      "type": "string",
      "description": "URL da imagem de capa"
    },
    "page_format": {
      "type": "string",
      "enum": [
        "A4",
        "A5",
        "Letter",
        "Carta 6x9"
      ],
      "default": "A4",
      "description": "Formato das páginas"
    },
    "dedication": {
      "type": "string",
      "description": "Dedicatória"
    },
    "preface": {
      "type": "string",
      "description": "Prefácio"
    },
    "references": {
      "type": "string",
      "description": "Referências bibliográficas (formato ABNT)"
    },
    "chapters_data": {
      "type": "string",
      "description": "JSON serializado dos módulos e aulas da apostila editados pelo admin"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "in_progress",
        "finished"
      ],
      "default": "draft",
      "description": "Status do livro"
    }
  },
  "required": [
    "author_email",
    "title"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}
