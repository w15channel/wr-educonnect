{
  "name": "ReceiptTemplate",
  "type": "object",
  "description": "Modelo visual padr\u00e3o do recibo de contribui\u00e7\u00e3o \u2014 a imagem aprovada pelo admin serve de refer\u00eancia para os pr\u00f3ximos recibos.",
  "properties": {
    "image_url": {
      "type": "string",
      "description": "URL da imagem do recibo escolhida como modelo padr\u00e3o"
    },
    "set_by": {
      "type": "string",
      "description": "Email do admin que definiu o modelo"
    }
  },
  "required": [
    "image_url"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}