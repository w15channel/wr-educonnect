{
  "name": "ForumReply",
  "type": "object",
  "properties": {
    "post_id": {
      "type": "string",
      "description": "ID of the parent post"
    },
    "author_name": {
      "type": "string",
      "description": "Name of the author"
    },
    "author_email": {
      "type": "string",
      "description": "Email of the author"
    },
    "author_role": {
      "type": "string",
      "enum": [
        "teacher",
        "student"
      ],
      "description": "Role of the author"
    },
    "content": {
      "type": "string",
      "description": "Reply content"
    },
    "course": {
      "type": "string",
      "enum": [
        "tcc",
        "psicanalise",
        "sexologia"
      ],
      "default": "tcc",
      "description": "Curso/turma da resposta"
    },
    "space": {
      "type": "string",
      "enum": [
        "forum",
        "debates"
      ],
      "default": "forum",
      "description": "\u00c1rea onde a resposta deve aparecer"
    }
  },
  "required": [
    "post_id",
    "content"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}