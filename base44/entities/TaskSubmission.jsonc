{
  "name": "TaskSubmission",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "description": "ID of the task"
    },
    "student_email": {
      "type": "string",
      "description": "Email of the student who submitted"
    },
    "student_name": {
      "type": "string",
      "description": "Name of the student"
    },
    "file_url": {
      "type": "string",
      "description": "URL of the uploaded file"
    },
    "file_name": {
      "type": "string",
      "description": "Name of the uploaded file"
    },
    "comment": {
      "type": "string",
      "description": "Student comment/text answer (for tasks without file)"
    },
    "quiz_answers": {
      "type": "array",
      "description": "Student's quiz answers \u2014 each item is index (choice) or {text: string} (written)",
      "items": {}
    },
    "grade": {
      "type": "number",
      "description": "Grade given by teacher"
    },
    "feedback": {
      "type": "string",
      "description": "Teacher feedback"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "graded"
      ],
      "default": "submitted",
      "description": "Status of the submission"
    }
  },
  "required": [
    "task_id",
    "student_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.student_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.student_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}