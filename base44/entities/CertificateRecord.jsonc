{
  "name": "CertificateRecord",
  "type": "object",
  "properties": {
    "verification_code": {
      "type": "string",
      "description": "Código único de autenticidade do certificado"
    },
    "student_name": {
      "type": "string",
      "description": "Nome completo do aluno"
    },
    "student_document": {
      "type": "string",
      "description": "CPF ou RG do aluno"
    },
    "student_email": {
      "type": "string",
      "description": "Email do aluno"
    },
    "student_access_code": {
      "type": "string",
      "description": "Código de acesso do aluno na plataforma"
    },
    "course_name": {
      "type": "string",
      "description": "Nome do curso"
    },
    "course_slug": {
      "type": "string",
      "description": "Slug do curso (tcc, psicanalise, sexologia)"
    },
    "description": {
      "type": "string",
      "description": "Texto complementar do certificado"
    },
    "coordinator_name": {
      "type": "string",
      "description": "Nome do coordenador que assinou"
    },
    "honor_title": {
      "type": "string",
      "description": "Título de honra (opcional)"
    },
    "honor_description": {
      "type": "string",
      "description": "Descrição do destaque de honra"
    },
    "issue_date": {
      "type": "string",
      "description": "Data de emissão formatada em pt-BR"
    },
    "template_id": {
      "type": "string",
      "description": "ID do template de certificado usado"
    },
    "total_hours": {
      "type": "number",
      "description": "Carga horária total do certificado"
    },
    "average_grade": {
      "type": "string",
      "description": "Média final do aluno"
    },
    "classes": {
      "type": "array",
      "description": "Lista de aulas, cargas e notas",
      "items": {
        "type": "object"
      }
    },
    "verification_url": {
      "type": "string",
      "description": "URL pública de verificação do certificado"
    },
    "is_available_to_student": {
      "type": "boolean",
      "default": true,
      "description": "Se o certificado está disponível para download pelo aluno"
    }
  },
  "required": [
    "verification_code",
    "student_name",
    "course_name"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}
