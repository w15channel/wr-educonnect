{
  "name": "Notification",
  "type": "object",
  "properties": {
    "recipient_email": {
      "type": "string",
      "description": "Email de quem deve receber a notificação (professor/admin)"
    },
    "sender_email": {
      "type": "string",
      "description": "Email de quem gerou a notificação (aluno)"
    },
    "sender_name": {
      "type": "string",
      "description": "Nome de quem gerou a notificação"
    },
    "message": {
      "type": "string",
      "description": "Texto da notificação"
    },
    "task_id": {
      "type": "string",
      "description": "ID da tarefa relacionada"
    },
    "task_title": {
      "type": "string",
      "description": "Título da tarefa"
    },
    "type": {
      "type": "string",
      "enum": [
        "task_submission",
        "quiz_submission"
      ],
      "default": "task_submission",
      "description": "Tipo de notificação"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Se a notificação foi lida"
    }
  },
  "required": [
    "recipient_email",
    "sender_email",
    "message"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}
