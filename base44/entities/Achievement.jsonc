{
  "name": "Achievement",
  "type": "object",
  "properties": {
    "dedupe_key": {
      "type": "string",
      "description": "Chave est\u00e1vel que impede a publica\u00e7\u00e3o duplicada"
    },
    "student_email": {
      "type": "string"
    },
    "course": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "lesson",
        "book_lesson",
        "task",
        "exam",
        "challenge",
        "module",
        "monitor",
        "tuition"
      ]
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "mentioned_emails": {
      "type": "array",
      "description": "Alunos homenageados na publica\u00e7\u00e3o \u2014 recebem as curtidas, rea\u00e7\u00f5es e respostas",
      "items": {
        "type": "string"
      }
    },
    "source_id": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "student_feature_until": {
      "type": "string",
      "format": "date-time",
      "description": "Fim do destaque individual da conquista"
    },
    "wall_highlight_until": {
      "type": "string",
      "format": "date-time",
      "description": "Fim do destaque da conquista no mural coletivo"
    }
  },
  "required": [
    "dedupe_key",
    "student_email",
    "kind",
    "message",
    "occurred_at"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}
