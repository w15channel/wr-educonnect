{
  "name": "SiteImprovementRequest",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Título da melhoria solicitada"
    },
    "area": {
      "type": "string",
      "description": "Área ou ferramenta do site relacionada"
    },
    "request_text": {
      "type": "string",
      "description": "Pedido original ou descrição da melhoria"
    },
    "ai_response": {
      "type": "string",
      "description": "Resposta, plano ou sugestão gerada pela IA"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved",
        "applied"
      ],
      "default": "draft",
      "description": "Status da proposta"
    }
  },
  "required": [
    "title",
    "request_text"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}
