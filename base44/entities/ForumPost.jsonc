{
  "name": "ForumPost",
  "type": "object",
  "properties": {
    "author_name": {
      "type": "string",
      "description": "Name of the author"
    },
    "author_email": {
      "type": "string",
      "description": "Email of the author"
    },
    "author_role": {
      "type": "string",
      "enum": [
        "teacher",
        "student"
      ],
      "description": "Role of the author"
    },
    "content": {
      "type": "string",
      "description": "Post content"
    },
    "topic": {
      "type": "string",
      "description": "Topic/category of the post"
    },
    "reply_count": {
      "type": "number",
      "default": 0,
      "description": "Number of replies"
    },
    "course": {
      "type": "string",
      "enum": [
        "tcc",
        "psicanalise",
        "sexologia"
      ],
      "default": "tcc",
      "description": "Turma/curso onde o post foi publicado"
    },
    "space": {
      "type": "string",
      "enum": [
        "forum",
        "debates"
      ],
      "default": "forum",
      "description": "Área onde a publicação deve aparecer"
    },
    "bot_replied": {
      "type": "boolean",
      "default": false,
      "description": "Se o bot já respondeu automaticamente"
    }
  },
  "required": [
    "content"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}
