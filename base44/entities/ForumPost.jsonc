{
  "name": "ForumPost",
  "type": "object",
  "properties": {
    "author_name": {
      "type": "string",
      "description": "Name of the author"
    },
    "author_email": {
      "type": "string",
      "description": "Email of the author"
    },
    "author_role": {
      "type": "string",
      "enum": [
        "teacher",
        "student"
      ],
      "description": "Role of the author"
    },
    "content": {
      "type": "string",
      "description": "Post content"
    },
    "topic": {
      "type": "string",
      "description": "Topic/category of the post"
    },
    "reply_count": {
      "type": "number",
      "default": 0,
      "description": "Number of replies"
    },
    "course": {
      "type": "string",
      "enum": [
        "tcc",
        "psicanalise",
        "sexologia"
      ],
      "default": "tcc",
      "description": "Turma/curso onde o post foi publicado"
    },
    "space": {
      "type": "string",
      "enum": [
        "forum",
        "debates"
      ],
      "default": "forum",
      "description": "\u00c1rea onde a publica\u00e7\u00e3o deve aparecer"
    },
    "bot_replied": {
      "type": "boolean",
      "default": false,
      "description": "Se o bot j\u00e1 respondeu automaticamente"
    }
  },
  "required": [
    "content"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}