{
  "name": "Tuition",
  "type": "object",
  "properties": {
    "student_email": {
      "type": "string",
      "description": "Email do aluno"
    },
    "student_name": {
      "type": "string",
      "description": "Nome do aluno"
    },
    "month_ref": {
      "type": "string",
      "description": "Refer\u00eancia do m\u00eas (ex: 2025-01)"
    },
    "amount": {
      "type": "number",
      "description": "Valor da mensalidade"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Data de vencimento"
    },
    "paid_date": {
      "type": "string",
      "format": "date",
      "description": "Data de pagamento"
    },
    "paid_amount": {
      "type": "number",
      "description": "Valor efetivamente contribu\u00eddo pelo aluno \u2014 pode ser menor que o valor lan\u00e7ado e ainda assim quita a mensalidade"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "overdue"
      ],
      "default": "pending",
      "description": "Status do pagamento"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    },
    "receipt_code": {
      "type": "string",
      "description": "C\u00f3digo de registro do recibo de contribui\u00e7\u00e3o volunt\u00e1ria, gerado na emiss\u00e3o"
    },
    "wall_shared": {
      "type": "boolean",
      "default": false,
      "description": "Se a contribui\u00e7\u00e3o j\u00e1 foi publicada no mural de supera\u00e7\u00e3o"
    }
  },
  "required": [
    "student_email",
    "month_ref"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}