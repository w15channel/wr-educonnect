{
  "name": "Tuition",
  "type": "object",
  "properties": {
    "student_email": {
      "type": "string",
      "description": "Email do aluno"
    },
    "student_name": {
      "type": "string",
      "description": "Nome do aluno"
    },
    "month_ref": {
      "type": "string",
      "description": "Refer\u00eancia mensal no formato YYYY-MM"
    },
    "amount": {
      "type": "number",
      "description": "Valor de refer\u00eancia da mensalidade"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Data de vencimento"
    },
    "paid_date": {
      "type": "string",
      "format": "date",
      "description": "Data do pagamento confirmada"
    },
    "paid_amount": {
      "type": "number",
      "description": "Valor efetivamente contribu\u00eddo e confirmado"
    },
    "reported_date": {
      "type": "string",
      "format": "date",
      "description": "Data de pagamento informada pelo aluno"
    },
    "reported_amount": {
      "type": "number",
      "description": "Valor de pagamento informado pelo aluno"
    },
    "reported_at": {
      "type": "string",
      "format": "date-time",
      "description": "Instante em que o aluno enviou o registro para confer\u00eancia"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "under_review",
        "paid",
        "overdue"
      ],
      "default": "pending",
      "description": "Status do pagamento"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    },
    "receipt_code": {
      "type": "string",
      "description": "C\u00f3digo de registro do recibo"
    },
    "wall_shared": {
      "type": "boolean",
      "default": false,
      "description": "Se a contribui\u00e7\u00e3o j\u00e1 foi publicada no mural"
    }
  },
  "required": [
    "student_email",
    "month_ref"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}