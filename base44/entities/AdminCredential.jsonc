{
  "name": "AdminCredential",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Admin email"
    },
    "password_hash": {
      "type": "string",
      "description": "Simple hashed password (base64)"
    },
    "is_configured": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "email",
    "password_hash"
  ]
}