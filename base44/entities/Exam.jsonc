{
  "name": "Exam",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Título da prova"
    },
    "description": {
      "type": "string",
      "description": "Instruções para o aluno"
    },
    "course": {
      "type": "string",
      "enum": [
        "tcc",
        "psicanalise",
        "sexologia"
      ],
      "default": "tcc",
      "description": "Curso ao qual a prova pertence"
    },
    "deadline": {
      "type": "string",
      "format": "date-time",
      "description": "Prazo final para realização"
    },
    "max_grade": {
      "type": "number",
      "default": 10,
      "description": "Pontuação máxima"
    },
    "quiz_questions": {
      "type": "array",
      "description": "Questões geradas pela IA ou criadas manualmente",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "answer_type": {
            "type": "string",
            "enum": [
              "choice",
              "text"
            ]
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "correct_index": {
            "type": "number",
            "description": "Índice da resposta correta (somente múltipla escolha)"
          }
        }
      }
    },
    "module_ref": {
      "type": "string",
      "description": "Referência ao módulo da apostila usado (ex: mod1)"
    },
    "generated_by_ai": {
      "type": "boolean",
      "default": false,
      "description": "Se foi gerada pelo gerador de IA"
    },
    "is_published": {
      "type": "boolean",
      "default": true,
      "description": "Se está visível para os alunos"
    }
  },
  "required": [
    "title",
    "course"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}
