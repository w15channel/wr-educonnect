{
  "name": "Exam",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "T\u00edtulo da prova"
    },
    "description": {
      "type": "string",
      "description": "Instru\u00e7\u00f5es para o aluno"
    },
    "course": {
      "type": "string",
      "enum": [
        "tcc",
        "psicanalise",
        "sexologia"
      ],
      "default": "tcc",
      "description": "Curso ao qual a prova pertence"
    },
    "deadline": {
      "type": "string",
      "format": "date-time",
      "description": "Prazo final para realiza\u00e7\u00e3o"
    },
    "max_grade": {
      "type": "number",
      "default": 10,
      "description": "Pontua\u00e7\u00e3o m\u00e1xima"
    },
    "quiz_questions": {
      "type": "array",
      "description": "Quest\u00f5es geradas pela IA ou criadas manualmente",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "answer_type": {
            "type": "string",
            "enum": [
              "choice",
              "text"
            ]
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "correct_index": {
            "type": "number"
          }
        }
      }
    },
    "module_ref": {
      "type": "string",
      "description": "Refer\u00eancia ao m\u00f3dulo da apostila usado (ex: mod1)"
    },
    "generated_by_ai": {
      "type": "boolean",
      "default": false,
      "description": "Se foi gerada pelo gerador de IA"
    },
    "is_published": {
      "type": "boolean",
      "default": true,
      "description": "Se est\u00e1 vis\u00edvel para os alunos"
    }
  },
  "required": [
    "title",
    "course"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}