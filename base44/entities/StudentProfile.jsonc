{
  "name": "StudentProfile",
  "type": "object",
  "properties": {
    "code_id": {
      "type": "string",
      "description": "ID do c\u00f3digo de acesso vinculado"
    },
    "student_email": {
      "type": "string",
      "description": "Email do aluno"
    },
    "full_name": {
      "type": "string",
      "description": "Nome completo"
    },
    "nickname": {
      "type": "string",
      "description": "Apelido / Nickname"
    },
    "email": {
      "type": "string",
      "description": "Email pessoal"
    },
    "birth_date": {
      "type": "string",
      "format": "date",
      "description": "Data de nascimento"
    },
    "whatsapp": {
      "type": "string",
      "description": "WhatsApp"
    },
    "photo_url": {
      "type": "string",
      "description": "URL da foto de perfil"
    },
    "avatar_color": {
      "type": "string",
      "description": "Cor do avatar"
    },
    "avatar_emoji": {
      "type": "string",
      "description": "ID do avatar emoji selecionado"
    },
    "bio": {
      "type": "string",
      "description": "Apresenta\u00e7\u00e3o pessoal"
    },
    "points": {
      "type": "number",
      "default": 0,
      "description": "Pontua\u00e7\u00e3o total gamificada"
    },
    "pontuacao_total": {
      "type": "number",
      "default": 0,
      "description": "Pontua\u00e7\u00e3o total sincronizada para ranking geral"
    },
    "pontuacao_estudos": {
      "type": "number",
      "default": 0,
      "description": "Pontua\u00e7\u00e3o acad\u00eamica/estudos: aulas assistidas, trabalhos entregues e provas"
    },
    "pontuacao_total_manual": {
      "type": "number",
      "description": "Pontua\u00e7\u00e3o total definida manualmente pelo admin (sobrescreve o c\u00e1lculo autom\u00e1tico)"
    },
    "pontuacao_total_manual_ativa": {
      "type": "boolean",
      "default": false,
      "description": "Quando true, a pontua\u00e7\u00e3o total manual substitui a calculada automaticamente"
    },
    "participacoes_manual": {
      "type": "number",
      "description": "N\u00famero de participa\u00e7\u00f5es definido manualmente pelo admin"
    },
    "participacoes_manual_ativa": {
      "type": "boolean",
      "default": false,
      "description": "Quando true, o n\u00famero de participa\u00e7\u00f5es manual substitui o calculado automaticamente"
    },
    "dashboard_rank": {
      "type": "number",
      "description": "Posi\u00e7\u00e3o publicada para o ranking da Dashboard"
    },
    "dashboard_course": {
      "type": "string",
      "enum": [
        "tcc",
        "psicanalise",
        "sexologia"
      ],
      "description": "Curso da posi\u00e7\u00e3o publicada na Dashboard"
    },
    "tuition_amount": {
      "type": "number",
      "description": "Valor de contribui\u00e7\u00e3o mensal escolhido pelo pr\u00f3prio aluno"
    },
    "tuition_due_day": {
      "type": "number",
      "description": "Dia do vencimento escolhido pelo aluno (1 a 28)"
    },
    "tuition_setup_at": {
      "type": "string",
      "format": "date-time",
      "description": "Momento em que o aluno definiu valor e vencimento da mensalidade"
    }
  },
  "required": [
    "student_email"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}