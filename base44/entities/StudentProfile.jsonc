{
  "name": "StudentProfile",
  "type": "object",
  "properties": {
    "code_id": {
      "type": "string",
      "description": "ID do c\u00f3digo de acesso vinculado"
    },
    "student_email": {
      "type": "string",
      "description": "Email do aluno"
    },
    "full_name": {
      "type": "string",
      "description": "Nome completo"
    },
    "nickname": {
      "type": "string",
      "description": "Apelido / Nickname"
    },
    "email": {
      "type": "string",
      "description": "Email pessoal"
    },
    "birth_date": {
      "type": "string",
      "format": "date",
      "description": "Data de nascimento"
    },
    "whatsapp": {
      "type": "string",
      "description": "WhatsApp"
    },
    "photo_url": {
      "type": "string",
      "description": "URL da foto de perfil"
    },
    "avatar_color": {
      "type": "string",
      "description": "Cor do avatar"
    },
    "avatar_emoji": {
      "type": "string",
      "description": "ID do avatar emoji selecionado"
    },
    "bio": {
      "type": "string",
      "description": "Apresenta\u00e7\u00e3o pessoal"
    },
    "points": {
      "type": "number",
      "default": 0,
      "description": "Pontua\u00e7\u00e3o total gamificada"
    },
    "dashboard_rank": {
      "type": "number",
      "description": "Posi\u00e7\u00e3o publicada para o ranking da Dashboard"
    },
    "dashboard_course": {
      "type": "string",
      "enum": [
        "tcc",
        "psicanalise",
        "sexologia"
      ],
      "description": "Curso da posi\u00e7\u00e3o publicada na Dashboard"
    }
  },
  "required": [
    "student_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.student_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {},
    "update": {
      "$or": [
        {
          "data.student_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}