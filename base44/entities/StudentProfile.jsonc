{
  "name": "StudentProfile",
  "type": "object",
  "properties": {
    "code_id": {
      "type": "string",
      "description": "ID do código de acesso vinculado"
    },
    "student_email": {
      "type": "string",
      "description": "Email do aluno"
    },
    "full_name": {
      "type": "string",
      "description": "Nome completo"
    },
    "nickname": {
      "type": "string",
      "description": "Apelido / Nickname"
    },
    "email": {
      "type": "string",
      "description": "Email pessoal"
    },
    "birth_date": {
      "type": "string",
      "format": "date",
      "description": "Data de nascimento"
    },
    "whatsapp": {
      "type": "string",
      "description": "WhatsApp"
    },
    "photo_url": {
      "type": "string",
      "description": "URL da foto de perfil"
    },
    "avatar_color": {
      "type": "string",
      "description": "Cor do avatar"
    },
    "avatar_emoji": {
      "type": "string",
      "description": "ID do avatar emoji selecionado"
    },
    "bio": {
      "type": "string",
      "description": "Apresentação pessoal"
    },
    "points": {
      "type": "number",
      "default": 0,
      "description": "Pontuação total gamificada"
    },
    "pontuacao_total": {
      "type": "number",
      "default": 0,
      "description": "Pontuação total sincronizada para ranking geral"
    },
    "pontuacao_estudos": {
      "type": "number",
      "default": 0,
      "description": "Pontuação acadêmica/estudos: aulas assistidas, trabalhos entregues e provas"
    },
    "dashboard_rank": {
      "type": "number",
      "description": "Posição publicada para o ranking da Dashboard"
    },
    "dashboard_course": {
      "type": "string",
      "enum": [
        "tcc",
        "psicanalise",
        "sexologia"
      ],
      "description": "Curso da posição publicada na Dashboard"
    }
  },
  "required": [
    "student_email"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}
