{
  "name": "WallReadReceipt",
  "type": "object",
  "description": "Confirma\u00e7\u00e3o individual de leitura de um destaque tempor\u00e1rio do Mural de Supera\u00e7\u00e3o.",
  "properties": {
    "dedupe_key": {
      "type": "string"
    },
    "reader_email": {
      "type": "string"
    },
    "highlight_key": {
      "type": "string"
    },
    "read_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "dedupe_key",
    "reader_email",
    "highlight_key",
    "read_at"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}