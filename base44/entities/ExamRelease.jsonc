{
  "name": "ExamRelease",
  "type": "object",
  "properties": {
    "student_email": {
      "type": "string",
      "description": "Email do aluno com as provas liberadas"
    },
    "student_name": {
      "type": "string",
      "description": "Nome do aluno"
    },
    "course": {
      "type": "string",
      "enum": [
        "tcc",
        "psicanalise",
        "sexologia"
      ],
      "default": "tcc"
    },
    "module_number": {
      "type": "number",
      "minimum": 1,
      "maximum": 10,
      "description": "M\u00f3dulo cujas provas foram liberadas pelo admin"
    },
    "percent_at_release": {
      "type": "number",
      "description": "Percentual do checklist no instante da libera\u00e7\u00e3o"
    },
    "completed_activities": {
      "type": "number",
      "description": "Atividades cumpridas no instante da libera\u00e7\u00e3o"
    },
    "total_activities": {
      "type": "number",
      "description": "Atividades exigidas no m\u00f3dulo no instante da libera\u00e7\u00e3o"
    },
    "released_at": {
      "type": "string",
      "format": "date-time",
      "description": "Instante da libera\u00e7\u00e3o"
    },
    "released_by": {
      "type": "string",
      "description": "Email do admin que liberou"
    }
  },
  "required": [
    "student_email",
    "module_number",
    "released_at"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}
