{
  "name": "SupportTicket",
  "type": "object",
  "properties": {
    "student_email": {
      "type": "string",
      "description": "Email ou c\u00f3digo do aluno que abriu o chamado"
    },
    "student_name": {
      "type": "string",
      "description": "Nome do aluno"
    },
    "course": {
      "type": "string",
      "enum": [
        "tcc",
        "psicanalise",
        "sexologia"
      ],
      "default": "tcc",
      "description": "Curso do aluno"
    },
    "category": {
      "type": "string",
      "description": "Categoria do problema"
    },
    "title": {
      "type": "string",
      "description": "Assunto do chamado"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do que est\u00e1 dando errado"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "resolved"
      ],
      "default": "open",
      "description": "Situa\u00e7\u00e3o do chamado"
    },
    "support_response": {
      "type": "string",
      "description": "Resposta da equipe de suporte"
    },
    "responded_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data da resposta do suporte"
    }
  },
  "required": [
    "student_email",
    "title",
    "description"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}