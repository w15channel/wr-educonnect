{
  "name": "LiveSession",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Title of the live session"
    },
    "description": {
      "type": "string",
      "description": "Description of the session"
    },
    "course": {
      "type": "string",
      "enum": [
        "tcc",
        "psicanalise",
        "sexologia"
      ],
      "default": "tcc",
      "description": "Curso ao qual a sess\u00e3o ao vivo pertence"
    },
    "scheduled_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the live session is scheduled"
    },
    "stream_url": {
      "type": "string",
      "description": "URL of the live stream (YouTube Live, Twitch, etc.)"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "live",
        "ended"
      ],
      "default": "scheduled",
      "description": "Current status of the session"
    },
    "recording_url": {
      "type": "string",
      "description": "URL of the recording after the session ends"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}