{
  "name": "Announcement",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Announcement title"
    },
    "content": {
      "type": "string",
      "description": "Announcement content"
    },
    "type": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "urgent"
      ],
      "default": "info",
      "description": "Type of announcement"
    },
    "course": {
      "type": "string",
      "enum": [
        "tcc",
        "psicanalise",
        "sexologia"
      ],
      "default": "tcc",
      "description": "Curso ao qual o aviso pertence"
    },
    "recipient_email": {
      "type": "string",
      "description": "Email do destinat\u00e1rio espec\u00edfico, quando o aviso for individual"
    },
    "certificate_monitor_id": {
      "type": "string",
      "description": "ID do certificado de monitor vinculado"
    }
  },
  "required": [
    "content"
  ],
  "rls": {
    "update": true,
    "delete": true,
    "write": true
  }
}