{
  "name": "LiveAttendance",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "ID da sessão ao vivo"
    },
    "session_title": {
      "type": "string",
      "description": "Título da sessão"
    },
    "student_email": {
      "type": "string",
      "description": "Email do aluno"
    },
    "student_name": {
      "type": "string",
      "description": "Nome do aluno"
    },
    "confirmed_at": {
      "type": "string",
      "description": "Timestamp da confirmação de presença"
    }
  },
  "required": [
    "session_id",
    "student_email"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}
