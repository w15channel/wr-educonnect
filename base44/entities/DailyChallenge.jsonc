{
  "name": "DailyChallenge",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "description": "Data desta ofensiva (YYYY-MM-DD)"
    },
    "course": {
      "type": "string",
      "enum": [
        "tcc",
        "psicanalise",
        "sexologia"
      ],
      "default": "tcc"
    },
    "lesson_ref": {
      "type": "string",
      "description": "M\u00f3dulo e tema de refer\u00eancia usados para selecionar as perguntas"
    },
    "lesson_id": {
      "type": "string",
      "description": "ID da aula de refer\u00eancia"
    },
    "module_number": {
      "type": "number",
      "minimum": 1,
      "maximum": 10,
      "description": "M\u00f3dulo (1-10) ao qual a ofensiva pertence \u2014 usado no hist\u00f3rico acad\u00eamico"
    },
    "questions": {
      "type": "array",
      "description": "8 perguntas selecionadas para o dia com base no m\u00f3dulo e tema escolhidos",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          }
        }
      }
    },
    "created_by_admin": {
      "type": "string",
      "description": "Origem da gera\u00e7\u00e3o ou email do admin"
    }
  },
  "required": [
    "date",
    "course"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}