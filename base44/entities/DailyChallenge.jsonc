{
  "name": "DailyChallenge",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "description": "Data desta ofensiva (YYYY-MM-DD)"
    },
    "course": {
      "type": "string",
      "enum": [
        "tcc",
        "psicanalise",
        "sexologia"
      ],
      "default": "tcc"
    },
    "lesson_ref": {
      "type": "string",
      "description": "Módulo e tema de referência usados para selecionar as perguntas"
    },
    "lesson_id": {
      "type": "string",
      "description": "ID da aula de referência"
    },
    "questions": {
      "type": "array",
      "description": "8 perguntas selecionadas para o dia com base no módulo e tema escolhidos",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          }
        }
      }
    },
    "created_by_admin": {
      "type": "string",
      "description": "Origem da geração ou email do admin"
    }
  },
  "required": [
    "date",
    "course"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}
