{
  "description": "A Luna gera diariamente trilhas por curso e m\u00f3dulo atual, usando as cinco aulas recentes dos alunos e compartilhando perguntas dentro do mesmo grupo para economizar IA.",
  "name": "Ofensiva Di\u00e1ria Autom\u00e1tica",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 6 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "ofensiva_diaria_automatica",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "gerar_ofensiva": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "createDailyChallenge",
            "args": {
              "automation": {
                "type": "scheduled"
              },
              "mode": "luna_module_cohorts"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Gerar ofensiva di\u00e1ria",
            "description": "Luna cria trilhas por m\u00f3dulo e avan\u00e7o"
          }
        }
      }
    ]
  }
}