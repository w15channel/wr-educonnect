{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "liberacao_modulos_calendario",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "liberar_modulos": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncScheduledModuleReleases",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Liberar m\u00f3dulos por data",
            "description": "Preservar acessos e registrar novas libera\u00e7\u00f5es"
          }
        }
      }
    ]
  },
  "name": "Libera\u00e7\u00e3o autom\u00e1tica de m\u00f3dulos por calend\u00e1rio",
  "description": "\u00c0 meia-noite de Bras\u00edlia, registra os m\u00f3dulos cuja data de libera\u00e7\u00e3o chegou para todos os cursos, preservando os acessos existentes. Novos alunos recebem os m\u00f3dulos j\u00e1 dispon\u00edveis.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 0 * * *",
      "one_time_date": null,
      "timezone": "America/Sao_Paulo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}