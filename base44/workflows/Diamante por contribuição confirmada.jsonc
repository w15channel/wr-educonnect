{
  "name": "Diamante por contribui\u00e7\u00e3o confirmada",
  "description": "Concede automaticamente um diamante por contribui\u00e7\u00e3o volunt\u00e1ria confirmada acima de R$ 10, sem duplicar premia\u00e7\u00f5es j\u00e1 registradas.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "Tuition",
      "events": [
        "create",
        "update"
      ]
    },
    "condition": "${ .trigger.data.status == \"paid\" and (.trigger.data.paid_amount // 0) > 10 and (.trigger.event_type == \"create\" or .trigger.old_data.status != \"paid\" or .trigger.old_data.paid_amount != .trigger.data.paid_amount) }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "diamante_contribuicao_confirmada",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "grant_award": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "reconcileStudentChecklists",
            "args": {
              "source_entity": "Tuition",
              "source_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Reconhecer contribui\u00e7\u00e3o confirmada",
            "description": "Valor acima de R$ 10 e pagamento confirmado"
          }
        }
      }
    ]
  }
}